# ============================================================
#  CREDENCIALES IQ OPTION
# ============================================================
IQ_EMAIL=tu_correo
IQ_PASSWORD=tu_password

# ============================================================
#  SEGURO DE CUENTA  (NO TOCAR salvo que sepas lo que haces)
#  Este bot es SOLO PARA ESTUDIO en cuenta DEMO.
#  ALLOW_REAL debe permanecer en false.
# ============================================================
BALANCE_MODE=PRACTICE
ALLOW_REAL=false

# ============================================================
#  OPERACIÓN
# ============================================================
BASE_AMOUNT=1
EXPIRATION_MINUTES=5
TIMEFRAME_SECONDS=60
# Cuántas velas pedir por activo en cada ciclo (necesita >=300 para indicadores)
CANDLE_COUNT=400
# Segundo máximo de la nueva vela para considerar la entrada "a tiempo"
MAX_ENTRY_DELAY_SECONDS=10

# ============================================================
#  FILTROS DE ESTRATEGIA
#  (esta versión NO aplica límites diarios; corre continuo)
# ============================================================
MIN_PAYOUT=0.80
SQUEEZE_FACTOR=0.65
GIANT_CANDLE_FACTOR=2.2
LATERAL_FACTOR=0.25

# ============================================================
#  LÍMITES (desactivados en esta fase de estadísticas)
#  Se dejan por compatibilidad con la versión definitiva.
# ============================================================
ENFORCE_LIMITS=false
MAX_TRADES_PER_DAY=8
MAX_CONSECUTIVE_LOSSES=3
DAILY_STOP_LOSS_R=-3
DAILY_TAKE_PROFIT_R=5

# ============================================================
#  HORARIO (desactivado en esta fase)
# ============================================================
ENFORCE_SESSION=false
SESSION_START=07:30
SESSION_END=10:30
TIMEZONE=America/Bogota

# ============================================================
#  ACTIVOS
#  Lista separada por comas. Ej: EURUSD,GBPUSD,EURUSD-OTC
#  Los activos que terminan en -OTC se marcan is_otc=true en los CSV.
# ============================================================
ASSETS=EURUSD
ALLOW_OTC=false
